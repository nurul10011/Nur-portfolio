<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nurul Islam - Portfolio</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="nav-container">
            <div class="logo-section">
                <h1 class="logo">NI</h1>
                <span class="logo-text">Nurul Islam</span>
            </div>
            <ul class="nav-links">
                <li><a href="#home" class="nav-link">Home</a></li>
                <li><a href="#projects" class="nav-link">Projects</a></li>
                <li><a href="#about" class="nav-link">About</a></li>
                <li><a href="#contact" class="nav-link">Contact</a></li>
            </ul>
            <div class="hamburger">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section id="home" class="hero">
        <div class="hero-background">
            <div class="floating-shape shape-1"></div>
            <div class="floating-shape shape-2"></div>
            <div class="floating-shape shape-3"></div>
        </div>

        <div class="hero-content">
            <div class="hero-text">
                <div class="greeting-line">
                    <span class="greeting">Hello, I'm</span>
                </div>
                <h2 class="hero-title">Nurul Islam</h2>
                <p class="subtitle">Student Developer & AI Enthusiast</p>
                
                <p class="description">
                    A passionate learner from <strong>National University of Bangladesh</strong>, 
                    Marketing Department, based in Mirpur, Dhaka. I build creative web solutions 
                    and explore modern technologies with AI tools.
                </p>

                <div class="hero-buttons">
                    <button class="cta-btn primary-btn" onclick="scrollToProjects()">View My Work</button>
                    <button class="cta-btn secondary-btn" onclick="scrollToContact()">Get In Touch</button>
                </div>





                <div class="social-links">
                    <a href="https://github.com/nurul10011" target="_blank" class="social-icon" title="GitHub">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                        </svg>
                    </a>
                    <a href="mailto:antormit05@gmail.com" class="social-icon" title="Email">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                        </svg>
                    </a>
                    <a href="tel:+8801406383694" class="social-icon" title="Phone">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                        </svg>
                    </a>
                </div>
            </div>

            <div class="hero-profile">
                <div class="profile-image-container" onclick="jumpProfile(this)">
                    <img src="your-photo.png" alt="Nurul Islam" class="profile-image">
                </div>
            </div>
        </div>

        <div class="hero-stats">
            <div class="stat-item">
                <span class="stat-number">1+</span>
                <span class="stat-label">Year Learning</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
                <span class="stat-number">1</span>
                <span class="stat-label">Key Project</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
                <span class="stat-number">3</span>
                <span class="stat-label">AI Tools</span>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="about">
        <div class="section-container">
            <div class="section-header">
                <h3 class="section-title">About Me</h3>
                <div class="title-underline"></div>
            </div>

            <div class="about-content">
                <div class="about-text">
                    <p class="about-paragraph">
                        I'm a student at <strong>National University of Bangladesh</strong>, Marketing Department, 
                        with a strong passion for technology and web development.
                    </p>
                    <p class="about-paragraph">
                        I enjoy combining creativity with code and leveraging modern AI tools like Claude, Groq, and DeepSeek 
                        to build better solutions faster.
                    </p>
                </div>

                <div class="about-info">
    <div class="info-card">
        <span class="info-icon">🎓</span>
        <div class="info-details">
            <h4>Education</h4>
            <p>National University of Bangladesh<br>Marketing Department</p>
        </div>
    </div>
                <div class="info-card">
                    <span class="info-icon">💼</span>
                    <div class="info-details">
                        <h4>Current Role</h4>
                        <p>Junior Business Analyst<br>QA • QC • Data Entry</p>
                    </div>
                </div>
                <div class="info-card">
                    <span class="info-icon">📍</span>
                    <div class="info-details">
                        <h4>Location</h4>
                        <p>Mirpur, Dhaka<br>Bangladesh</p>
                    </div>
                </div>
                <div class="info-card">
                    <span class="info-icon">🤖</span>
                    <div class="info-details">
                        <h4>AI Tools</h4>
                        <p>Claude • Groq • DeepSeek</p>
                    </div>
                </div>
            </div>
            </div>

            <div class="skills-section">
                <h4 class="skills-title">Skills & Technologies</h4>
                <div class="skills-grid">
                    <div class="skill-tag">HTML5</div>
                    <div class="skill-tag">CSS3</div>
                    <div class="skill-tag">JavaScript</div>
                    <div class="skill-tag">Responsive Design</div>
                    <div class="skill-tag">Git & GitHub</div>
                    <div class="skill-tag">Problem Solving</div>
                    <div class="skill-tag">Web Design</div>
                </div>

                <h4 class="skills-title" style="margin-top: 2rem;">AI Tools & Platforms</h4>
                <div class="skills-grid">
                    <div class="skill-tag ai-tag">Claude AI</div>
                    <div class="skill-tag ai-tag">Groq</div>
                    <div class="skill-tag ai-tag">DeepSeek</div>
                    <div class="skill-tag ai-tag">AI-Assisted Development</div>
                    <div class="skill-tag ai-tag">Problem Solving</div>
                    <div class="skill-tag ai-tag">Creative Thinking</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="projects">
        <div class="section-container">
            <div class="section-header">
                <h3 class="section-title">Featured Projects</h3>
                <div class="title-underline"></div>
            </div>

            <div class="projects-grid">
                <div class="project-card">
                    <div class="project-card-inner">
                        <div class="project-image">
                            <div class="project-icon">📊</div>
                        </div>
                        
                        <div class="project-content">
                            <div class="project-badge">Personal Project</div>
                            <h4 class="project-title">Family Home Manager</h4>
                            <p class="project-description">
                                A comprehensive family expense tracker to manage household finances. 
                                Track spending across categories, set budgets, and visualize financial patterns.
                            </p>

                            <div class="project-highlights">
                                <span class="highlight">✓ Expense Tracking</span>
                                <span class="highlight">✓ Budget Planning</span>
                                <span class="highlight">✓ Data Analytics</span>
                            </div>

                            <div class="project-techs">
                                <span class="tech-badge">JavaScript</span>
                                <span class="tech-badge">HTML/CSS</span>
                                <span class="tech-badge">Local Storage</span>
                                <span class="tech-badge ai-badge">Claude AI</span>
                            </div>

                            <div class="project-footer">
                                <a href="https://github.com/nurul10011" target="_blank" class="project-link">
                                    View on GitHub
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M7 17L17 7M17 7H7m10 0v10"></path>
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="project-card">
                    <div class="project-card-inner">
                        <div class="project-image">
                            <div class="project-icon">🚀</div>
                        </div>
                        
                        <div class="project-content">
                            <div class="project-badge">Coming Soon</div>
                            <h4 class="project-title">More AI Projects</h4>
                            <p class="project-description">
                                Building innovative projects powered by Claude, Groq, and DeepSeek. 
                                Creating intelligent, efficient applications with AI integration.
                            </p>

                            <div class="project-highlights">
                                <span class="highlight">✓ In Development</span>
                                <span class="highlight">✓ AI Integration</span>
                                <span class="highlight">✓ Advanced Features</span>
                            </div>

                            <div class="project-techs">
                                <span class="tech-badge">React</span>
                                <span class="tech-badge">Node.js</span>
                                <span class="tech-badge">MongoDB</span>
                                <span class="tech-badge ai-badge">AI APIs</span>
                            </div>

                            <div class="project-footer">
                                <button class="project-link disabled">Coming Soon</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="contact">
        <div class="section-container">
            <div class="section-header">
                <h3 class="section-title">Let's Connect</h3>
                <div class="title-underline"></div>
            </div>

            <div class="contact-wrapper">
                <p class="contact-subtitle">I'd love to hear from you! Whether you have a question or just want to say hello, feel free to reach out.</p>

                <div class="contact-grid">
                    <div class="contact-card" onclick="sendEmail()">
                        <div class="contact-card-icon">📧</div>
                        <h4>Email</h4>
                        <a href="mailto:antormit05@gmail.com">antormit05@gmail.com</a>
                    </div>
                    <div class="contact-card" onclick="callPhone()">
                        <div class="contact-card-icon">📱</div>
                        <h4>Phone</h4>
                        <a href="tel:+8801406383694">01406383694</a>
                    </div>
                    <div class="contact-card">
                        <div class="contact-card-icon">💻</div>
                        <h4>GitHub</h4>
                        <a href="https://github.com/nurul10011" target="_blank">github.com/nurul10011</a>
                    </div>
                    <div class="contact-card" onclick="openMap()">
                        <div class="contact-card-icon">📍</div>
                        <h4>Location</h4>
                        <p>Mirpur 6, Block C, Road 2<br>Dhaka, Bangladesh</p>
                    </div>
                </div>

                <div class="contact-cta">
                    <a href="mailto:antormit05@gmail.com" class="contact-btn">Send me an Email</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
